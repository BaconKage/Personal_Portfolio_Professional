# Set to the NEW production origin before final deployment. No trailing slash.
# NEXT_PUBLIC_SITE_URL=https://your-new-domain.example

# "Ask the core" stays off until this is set (then redeploy: pages are prerendered).
# Set a monthly spend limit on the Anthropic workspace that owns this key.
# ANTHROPIC_API_KEY=
# Optional: the model that answers. Defaults to claude-opus-5-5; claude-haiku-5-5 is far cheaper.
# ASK_MODEL=claude-opus-5-5
